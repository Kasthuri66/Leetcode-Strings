class Solution {
    public boolean isPalindrome(String str) {
        String a = "";
        for (int i = 0; i < str.length(); i++) {
            char c = str.charAt(i);
            if (Character.isLetterOrDigit(c)) {
                a = a + Character.toLowerCase(c);
            }
        }
        String b = "";
        for (int i = a.length() - 1; i >= 0; i--) {
            b = b + a.charAt(i);
        }
        return b.equals(a);
    }
}