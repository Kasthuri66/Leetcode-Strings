class Solution {
    public String convert(String a, int numRows) {
        if (numRows == 1) {
            return a;
        }
        String[] c = new String[numRows];
        for (int i = 0; i < c.length; i++) {
            c[i] = "";
        }
        int cr = 0;
        boolean g = false;
        for (char ch : a.toCharArray()) {
            c[cr] += ch;
            if (cr == 0 || cr == numRows - 1) {
                g = !g;
            }
            cr += g ? 1 : -1;
        }
        String z = "";
        for (String row : c) {
            z = z + row;
        }
        return z;
    }
}